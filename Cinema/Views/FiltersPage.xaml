<Page
    x:Class="Cinema.Views.FiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Cinema.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PageRoot"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Orientation="Horizontal">

            <ComboBox
                Width="200"
                Height="50"
                DisplayMemberPath="Title"
                ItemsSource="{Binding DataContext.Genres, ElementName=PageRoot}"
                SelectedItem="{Binding DataContext.SelectedGenre, ElementName=PageRoot, Mode=TwoWay}" />
            <Button
                Width="Auto"
                Height="50"
                Command="{Binding DataContext.ApplyFiltersCommand, ElementName=PageRoot}"
                Content="Применить"
                IsEnabled="{Binding DataContext.ApplingIsActive, ElementName=PageRoot}" />

        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Width="Auto"
            Height="Auto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{Binding DataContext.StatusText, ElementName=PageRoot}" />

        <GridView
            Grid.Row="1"
            Grid.Column="0"
            ItemsSource="{Binding FilmsViewModels}">
            <GridView.ItemTemplate>
                <DataTemplate x:Name="filmTemplate">
                    <StackPanel
                        Height="Auto"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">

                        <Image
                            Width="300"
                            Height="400"
                            Source="{Binding Poster}" />

                        <TextBlock
                            Width="auto"
                            Height="auto"
                            FontSize="16"
                            FontWeight="Bold"
                            HorizontalTextAlignment="Center"
                            Text="{Binding TitleYear}"
                            TextWrapping="WrapWholeWords" />

                        <behaviors:Interaction.Behaviors>
                            <core:EventTriggerBehavior EventName="Tapped">
                                <core:InvokeCommandAction Command="{Binding DataContext.GetFilmInfoCommand, ElementName=PageRoot}" CommandParameter="{Binding Film}" />
                            </core:EventTriggerBehavior>
                        </behaviors:Interaction.Behaviors>

                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>